{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        // Mono marks code-like content such as URLs, tokens, and paths.
        "allow": ["layout", "font-family"],
        "contracts": [
          // The tabs root renders no chrome of its own.
          {
            "pattern": "^Tabs$",
            "allow": ["layout", "font-family", "color", "shape"]
          },
          // Containers whose children and inner padding come from the caller.
          {
            "pattern": "^(TabsList|RadioGroup|Toolbar|PopoverContent)$",
            "allow": ["layout", "font-family", "spacing"]
          }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error"
  },
  // Preserve existing effect synchronization and imperative viewer integration
  // during this dependency upgrade. New files retain the new React checks.
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      // Components own their appearance, including structural values.
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    {
      "files": [
        "src/components/github-open-panel.tsx",
        "src/components/diff-find-bar.tsx",
        "src/components/ui/theme-toggle.tsx",
        "src/components/github-diff-page.tsx",
        "src/components/diff-viewer.tsx",
        "src/routes/index.tsx",
        "src/routes/view.$slug.tsx"
      ],
      "rules": { "react/set-state-in-effect": "off" }
    },
    {
      "files": ["src/components/diff-viewer.tsx"],
      // The annotation epoch cache is deliberately maintained across renders.
      "rules": { "react/refs": "off" }
    },
    {
      "files": ["src/components/draft-review-annotation.tsx"],
      // This mutable body store preserves drafts across virtualized unmounts.
      "rules": { "react/immutability": "off" }
    }
  ]
}
